local RS = game:GetService("ReplicatedStorage")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Codec = require(RS.MovementV2.RemoteSnapshotCodec)
local Transport = require(RS.MovementV2.Transport)

local actors    = {}
local baselines = {}
local drawings  = {}
local TIMEOUT   = 2.0

Transport.getClientChannels().RemoteSnapshot.OnClientEvent:Connect(function(data)
    local frame, err = Codec.decode(data)
    if not frame then return end

    local now = tick()

    for _, actor in ipairs(frame.Actors) do
        actors[actor.ActorId] = {
            pos      = actor.Position,
            vel      = actor.Velocity,
            lastSeen = now,
            userId   = actor.UserId,
        }
        baselines[actor.ActorId] = actor
    end

    for _, delta in ipairs(frame.Deltas) do
        local base = baselines[delta.ActorId]
        if base then
            local updated = Codec.applyDeltaToCanonicalBaseline(base, delta, true)
            if updated then
                baselines[delta.ActorId] = updated
                actors[delta.ActorId] = {
                    pos      = updated.Position,
                    vel      = updated.Velocity,
                    lastSeen = now,
                    userId   = updated.UserId,
                }
            end
        end
    end
end)

local function clearDrawings()
    for _, d in ipairs(drawings) do
        pcall(function() d:Remove() end)
    end
    drawings = {}
end

-- Используем WorldToScreenPoint для точного совпадения с Drawing
local function w2s(pos)
    local sp, vis = Camera:WorldToScreenPoint(pos)
    return Vector2.new(sp.X, sp.Y), vis, sp.Z
end

-- Новая функция отрисовки обычного 2D бокса
local function drawESP(pos, color, frozen, name, dist)
    -- pos - это позиция HumanoidRootPart (примерно центр тела)
    -- Поднимаем точку до головы и опускаем до пят
    local headPos = pos + Vector3.new(0, 1.5, 0)
    local feetPos = pos - Vector3.new(0, 2.5, 0)

    local headSP, headVis, headZ = w2s(headPos)
    local feetSP, feetVis, feetZ = w2s(feetPos)

    -- Если голова или ноги за экраном/камерой, не рисуем
    if not headVis or not feetVis or headZ <= 0 or feetZ <= 0 then return end

    local height = math.abs(feetSP.Y - headSP.Y)
    local width = height / 2 -- Пропорции стандартного персонажа
    local centerX = feetSP.X
    local topY = headSP.Y
    local bottomY = feetSP.Y

    -- Защита от гигантских/крошечных боксов
    if height < 10 or height > 1000 then return end

    local leftX = centerX - (width / 2)
    local rightX = centerX + (width / 2)

    local corners = {
        Vector2.new(leftX, topY),
        Vector2.new(rightX, topY),
        Vector2.new(rightX, bottomY),
        Vector2.new(leftX, bottomY),
    }

    local alpha = frozen and 0.5 or 1

    -- Рисуем 4 линии
    for i = 1, 4 do
        local ln = Drawing.new("Line")
        ln.From         = corners[i]
        ln.To           = corners[i % 4 + 1]
        ln.Color        = color
        ln.Thickness    = 1.5
        ln.Transparency = alpha
        ln.Visible      = true
        table.insert(drawings, ln)
    end

    -- Текст с именем (сверху)
    local ntxt = Drawing.new("Text")
    ntxt.Text     = name .. (frozen and " ?" or "")
    ntxt.Position = Vector2.new(centerX, topY - 16)
    ntxt.Size     = 14
    ntxt.Color    = color
    ntxt.Outline  = true
    ntxt.Center   = true
    ntxt.Visible  = true
    table.insert(drawings, ntxt)

    -- Текст с дистанцией (снизу)
    local dtxt = Drawing.new("Text")
    dtxt.Text     = dist .. "m"
    dtxt.Position = Vector2.new(centerX, bottomY + 2)
    dtxt.Size     = 12
    dtxt.Color    = Color3.new(1,1,1)
    dtxt.Outline  = true
    dtxt.Center   = true
    dtxt.Visible  = true
    table.insert(drawings, dtxt)
end

local LP = Players.LocalPlayer

RunService.Heartbeat:Connect(function()
    clearDrawings()

    local now    = tick()
    local camPos = Camera.CFrame.Position

    for id, data in pairs(actors) do
        local age = now - data.lastSeen

        if age > TIMEOUT then
            actors[id]    = nil
            baselines[id] = nil
            continue
        end

        -- Предсказание движения
        local predictedPos = data.pos
        if age > 0.1 and data.vel then
            local decay = math.max(0, 1 - age * 0.3)
            predictedPos = data.pos + data.vel * age * decay
        end

        local frozen = age > 0.15
        local dist    = math.floor((camPos - predictedPos).Magnitude)

        -- Игнорируем себя
        local name = tostring(data.userId)
        local pl = Players:GetPlayerByUserId(data.userId)
        if pl then 
            name = pl.Name 
            if pl == LP then continue end
        end

        -- Цвет: красный для живых, оранжевый для "замороженных" (потерявших связь)
        local color = frozen
            and Color3.fromRGB(255, 165, 0)
            or  Color3.fromRGB(0, 255, 0) -- Сделал ярко-зеленым для заметности

        drawESP(predictedPos, color, frozen, name, dist)
    end
end)
